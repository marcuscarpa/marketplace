        <!-- ===== RATE LIMIT ===== -->
        <mxCell id="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#dc2626;fillColor=#2d1515;fontSize=9;align=left;spacingLeft=8;" value="
Rate Limiting (lib/rate-limit.ts)
  Lua script atomic INCR+EXPIRE
  Key: rl:{ip}:{endpoint}
  Configurable fail-open (H-03)
  Per-endpoint limits in middleware
" connectable="0" parent="1">
          <mxGeometry x="360" y="700" width="500" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== SECURITY ===== -->
        <mxCell id="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6b7280;fillColor=#1f2937;fontSize=9;align=left;spacingLeft=8;" value="
Security Layer
  CSP (lib/security/csp.ts): nonce, frame-ancestors X-Frame-Options, HSTS
  HMAC (lib/security/hmac.ts): webhook signature validation
  Bot Protection (lib/security/bot-protection.ts): checkRateLimit() on all endpoints
  Secrets (lib/secrets.ts): XOR+Base64 + SHA-256 integrity on Redis
  IP Spoofing (middleware.ts): reject x-vercel-forwarded-for from private IPs
" connectable="0" parent="1">
          <mxGeometry x="360" y="775" width="500" height="80" as="geometry"/>

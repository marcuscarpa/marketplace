        <mxCell id="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#34d399;fillColor=#0d3320;fontSize=9;align=left;spacingLeft=8;" value="

Key Schema (Redis)

CART:
  cart:user:{id}     → JSON cart
  cart:guest:{uuid}  → JSON cart

AUTH:
  refresh:{userId}    → {token, exp}
  consent_ledger:{id} → LPUSH records
  audit_log:{id}      → LPUSH events

RATE LIMIT:
  rl:{ip}:{endpoint}  → INCR+EXPIRE (Lua)

WISHLIST:
  wishlist:guest:{uuid}
  wishlist:user:{id}

LOCK:
  lock:product:{handle}
  lock:cart:{cartId}

CACHE:
  cache:product:{handle}
  cache:products:batch:{handles}

STAMPEDE:
  stampede:{cacheKey}


" connectable="0" parent="1">
          <mxGeometry x="980" y="120" width="200" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#34d399;fillColor=#14532d;fontSize=9;align=left;spacingLeft=8;" value="
Multi-Region:
  Map<regionCode, Redis>
  US / EU / BR / APAC
  + fallback REDIS_URL

lazyConnect: true
" connectable="0" parent="1">
          <mxGeometry x="980" y="670" width="200" height="70" as="geometry"/>
        </mxCell>


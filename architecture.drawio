        <!-- ===== REDIS BOX ===== -->
        <mxCell id="redis-box" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeColor=#34d399;fillColor=#0d3320;fontSize=11;">

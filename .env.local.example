# Copy to .env.local and replace placeholders with real values.
# For local dev without Shopify, you can skip this — `.env.development` is enough.

# ============================================
# REQUIRED — Shopify stores (US, EU, BR, APAC)
# Use `auto` for US token when using Dev Dashboard Client ID + Secret (2026+ apps).
SHOPIFY_STORE_DOMAIN_US=your-store-us.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_US=auto
SHOPIFY_STORE_DOMAIN_EU=your-store-eu.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_EU=your_storefront_token_eu
SHOPIFY_STORE_DOMAIN_BR=your-store-br.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_BR=your_storefront_token_br
SHOPIFY_STORE_DOMAIN_APAC=your-store-apac.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_APAC=your_storefront_token_apac

# ============================================
# REQUIRED — Redis
# ============================================
# Production Redis runs on Railway (project: Sinesia Karol).
#
# --- Deployed on Railway (same project) ---
# Use the internal URL from Variables (works only inside Railway network):
#   REDIS_URL=redis://default:PASSWORD@sinesia-karol.railway.internal:6379
# Do NOT use the bare host:port — always include redis://, user, and password.
#
# --- Local dev (your machine) ---
# sinesia-karol.railway.internal does NOT resolve locally.
# Use REDIS_PUBLIC_URL or build from TCP proxy vars:
#   redis://default:PASSWORD@RAILWAY_TCP_PROXY_DOMAIN:RAILWAY_TCP_PROXY_PORT
#
# Without .env.local, npm run dev uses .env.development stub (redis://127.0.0.1:6379).
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_TCP_PROXY_HOST:YOUR_TCP_PROXY_PORT
# Optional per-region overrides:
# REDIS_URL_US=
# REDIS_URL_EU=
# REDIS_URL_BR=
# REDIS_URL_APAC=
REDIS_TOKEN=your_upstash_token_if_upstash
REDIS_PUBSUB_CHANNEL=cache:invalidate

# ============================================
# REQUIRED — Shopify OAuth (Customer Account API)
# ============================================
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
SHOPIFY_API_VERSION=2026-04
NEXTAUTH_URL=https://your-site.com

# ============================================
# Preview deploy without integrations (Railway/Vercel staging)
# ============================================
# ALLOW_INTEGRATION_STUBS=true

# ============================================
# App defaults
# ============================================
# Presentation: https://sinesia.jethro.agency/ (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://sinesia.jethro.agency
NEXT_PUBLIC_DEFAULT_LOCALE=en
RATE_LIMIT_FAIL_OPEN=false
LOG_LEVEL=info

# ============================================
# OBSERVABILITY (optional)
# ============================================
SENTRY_DSN=https://key@sentry.io/project
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# BOT PROTECTION (optional)
# ============================================
ARCJET_KEY=your_arcjet_key

# ============================================
# LAUNCHDARKLY & EDGE CONFIG (optional)
# ============================================
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_sdk_key
EDGE_CONFIG=your_edge_config_connection_string
EDGE_CONFIG_ID=your_edge_config_id

# ============================================
# AWS SECRETS MANAGER (optional)
# ============================================
AWS_REGION=us-east-1
SECRETS_PREFIX=/shopify/

# ============================================
# KLAVIYO (optional)
# ============================================
KLAVIYO_PUBLIC_API_KEY=your_klaviyo_public_api_key
NEXT_PUBLIC_KLAVIYO_PUBLIC_API_KEY=your_public_klaviyo_key

# ============================================
# MARKETING ASSETS (optional)
# ============================================
# NEXT_PUBLIC_ASSET_ORIGIN=
# DESIGN_REFERENCE_URL=

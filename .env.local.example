# ============================================
# SHOPIFY STORES (US, EU, BR, APAC)
# ============================================
SHOPIFY_STORE_DOMAIN_US=your-store-us.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_US=your_token_us
SHOPIFY_STORE_DOMAIN_EU=your-store-eu.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_EU=your_token_eu
SHOPIFY_STORE_DOMAIN_BR=your-store-br.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_BR=your_token_br
SHOPIFY_STORE_DOMAIN_APAC=your-store-apac.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN_APAC=your_token_apac

# ============================================
# SHOPIFY CUSTOMER ACCOUNT API (OAuth PKCE)
# ============================================
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
NEXTAUTH_URL=https://your-site.com

# ============================================
# REDIS (Global – Upstash or Redis Enterprise)
# ============================================
REDIS_URL=redis://default:password@host:6379
REDIS_TOKEN=your_upstash_token_if_upstash
REDIS_PUBSUB_CHANNEL=cache:invalidate

# ============================================
# WEBHOOK SECURITY
# ============================================
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# OBSERVABILITY
# ============================================
SENTRY_DSN=https://key@sentry.io/project
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# BOT PROTECTION
# ============================================
ARCJET_KEY=your_arcjet_key

# ============================================
# LAUNCHDARKLY & EDGE CONFIG
# ============================================
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_sdk_key
EDGE_CONFIG=your_edge_config_connection_string
EDGE_CONFIG_ID=your_edge_config_id

# ============================================
# AWS SECRETS MANAGER
# ============================================
AWS_REGION=us-east-1
SECRETS_PREFIX=/shopify/

# ============================================
# KLAVIYO
# ============================================
KLAVIYO_PUBLIC_API_KEY=your_klaviyo_public_api_key
NEXT_PUBLIC_KLAVIYO_PUBLIC_API_KEY=your_public_klaviyo_key

# ============================================
# MARKETING ASSETS & DESIGN AUDITS
# ============================================
# Optional: override marketing image CDN (default: framerusercontent.com)
# NEXT_PUBLIC_ASSET_ORIGIN=
# External design reference site for scripts/measure-*.mjs
# DESIGN_REFERENCE_URL=

# ============================================
# DEFAULT LOCALE
# ============================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
LOG_LEVEL=info
  "htmlSnippet": "<body data-container=\"body\" id=\"html-body\" class=\"checkout-cart-index page-layout-1column show-didomi force-load using-mouse joinus-modal lowindex modal-relative\" aria-busy=\"false\" style=\"overflow: hidden;\"><div id=\"didomi-host\" class=\"didomi-host\" data-nosnippet=\"true\" aria-hidden=\"true\" lang=\"en\" data-lang-dir=\"ltr\"></div>\n        <script>\n    window.closeIcon = \"https://www.zimmermann.com/static/version1780978756/frontend/tryzens/zimmermann/en_US/images/icons-sprite.svg#close\";\n    window.imgStaticPath = \"https://www.zimmermann.com/static/version1780978756/frontend/tryzens/zimmermann/en_US/images\";\n</script>\n<script type=\"text/javascript\">\n    require(['lazysizes', 'picturefill', 'closestPolyfill']);\n    require([\n        'svg4everybody'\n    ],\n    function() {\n\n\n        // polyfill for nodeList.forEach method\n        NodeList.prototype.forEach = function(callback) {\n            for (var i = 0; i < this.length; i++) {\n                callback.call(this, this[i], i, this);\n            }\n        }\n        svg4everybody();\n    });\n</script>\n\n\n\n<div class=\"ambanners ambanner-10\" data-position=\"10\" data-role=\"amasty-banner-container\"></div>\n\n<div class=\"cookie-status-message\" id=\"cookie-status\" style=\"display: none;\">\n    The store will not work correctly in the case when cookies are disabled.</div>\n<script type=\"text/javascript\">document.querySelector(\"#cookie-status\").style.display = \"none\";</script>\n\n\n\n    <noscript>\n        <div class=\"message global noscript\">\n            <div class=\"content\">\n                <p>\n                    <strong>JavaScript seems to be disabled in your browser.</strong>\n                    <span>\n                        For the best experience on our site, be sure to turn on Javascript in your browser.                    </span>\n                </p>\n            </div>\n        </div>\n    </noscript>\n<script>    require.config({\n        map: {\n            '*': {\n                wysiwygAdapter: 'mage/adminhtml/wysiwyg/tiny_mce/tinymceAdapter'\n            }\n        }\n    });</script><script type=\"text/javascript\">\n    require(['jquery', 'mage/cookies'], function($) {\n        $(document).ready(function () {\n           $('.cookie-message__container').find('a').each(function() {\n               if($(this).attr('href') && $(this).attr('href') != null) {\n                   $(this).attr(\"aria-label\",\"Privacy Policy\");\n               }\n           });\n\n       });\n   });\n</script>\n<div role=\"alertdialog\" class=\"js-currency-lang-popup currency-lang\" data-type=\"cookie\" tabindex=\"0\" aria-label=\"Currency Language Popup\" data-heading=\"\" data-desc=\"\" data-continue-txt=\"\" data-change-txt=\"\" data-continue-btn=\"English\" data-change-btn=\"English\">\n    <div class=\"currency-lang__bg js-currency-lang__bg\"></div>\n    <div class=\"currency-lang__text\">\n        <div class=\"currency-lang__logo\">\n            <img alt=\"ZIMMERMANN logo\" src=\"https://www.zimmermann.com/static/version1780978756/frontend/tryzens/zimmermann/en_US/images/icons/logo.svg\">\n        </div>\n        <a href=\"javascript:void(0)\" class=\"currency-lang__close js-continue-language\" aria-label=\"Close Language Modal\">\n            <svg aria-hidden=\"true\" focusable=\"false\" class=\"\">\n                <use xlink:href=\"https://www.zimmermann.com/static/version1780978756/frontend/tryzens/zimmermann/en_US//images/icons-sprite.svg#close\"></use>\n            </svg>\n        </a>\n        <h2 class=\"currency-lang__head js-currency-lang__head\">\n            <div class=\"sr-only\">\n                Language\n            </div>\n        </h2>\n        <p class=\"modal-content js-currency-lang__content\"></p>\n        <div class=\"currency-lang__btns\">\n            <a href=\"javascript:void(0);\" id=\"continue-language\" class=\"js-continue-language currency-lang__change-btn button button--primay currency-lang__change-btn js-currency-lang__change-btn no-opacity\">\n                CONTINUE IN English            </a>\n            <a href=\"javascript:void(0);\" data-custom-href=\"\" id=\"change-language\" class=\"js-change-language cookie-deny button button--secondary currency-lang__deny-btn\">\n                change to Italian            </a>\n        </div>\n    </div>\n</div>\n\n<script>\n    window.cookiesConfig = window.cookiesConfig || {};\n    window.cookiesConfig.secure = true;\n</script><script>    require.config({\n        paths: {\n            googleMaps: 'https\\u003A\\u002F\\u002Fmaps.googleapis.com\\u002Fmaps\\u002Fapi\\u002Fjs\\u003Fv\\u003D3\\u0026key\\u003D'\n        },\n        config: {\n            'Magento_PageBuilder/js/utils/map': {\n                style: '',\n            },\n            'Magento_PageBuilder/js/content-type/map/preview': {\n                apiKey: '',\n                apiKeyErrorMessage: 'You\\u0020must\\u0020provide\\u0020a\\u0020valid\\u0020\\u003Ca\\u0020href\\u003D\\u0027https\\u003A\\u002F\\u002Fwww.zimmermann.com\\u002Fus\\u002Fadminhtml\\u002Fsystem_config\\u002Fedit\\u002Fsection\\u002Fcms\\u002F\\u0023cms_pagebuilder\\u0027\\u0020target\\u003D\\u0027_blank\\u0027\\u003EGoogle\\u0020Maps\\u0020API\\u0020key\\u003C\\u002Fa\\u003E\\u0020to\\u0020use\\u0020a\\u0020map.'\n            },\n            'Magento_PageBuilder/js/form/element/map': {\n                apiKey: '',\n                apiKeyErrorMessage: 'You\\u0020must\\u0020provide\\u0020a\\u0020valid\\u0020\\u003Ca\\u0020href\\u003D\\u0027https\\u003A\\u002F\\u002Fwww.zimmermann.com\\u002Fus\\u002Fadminhtml\\u002Fsystem_config\\u002Fedit\\u002Fsection\\u002Fcms\\u002F\\u0023cms_pagebuilder\\u0027\\u0020target\\u003D\\u0027_blank\\u0027\\u003EGoogle\\u0020Maps\\u0020API\\u0020key\\u003C\\u002Fa\\u003E\\u0020to\\u0020use\\u0020a\\u0020map.'\n            },\n        }\n    });</script><script>\n    require.config({\n        shim: {\n            'Magento_PageBuilder/js/utils/map': {\n                deps: ['googleMaps']\n            }\n        }\n    });</script><!-- Google Tag Manager (noscript) -->\n<noscript><iframe src=\"https://ruffles.zimmermann.com/ns.html?id=GTM-M8PJ5D\"\nheight=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n<!-- End Google Tag Manager (noscript) -->\n\n<script type=\"text/javascript\">\n    if(localStorage['mage-cache-storage']){\n        var  customerData = JSON.parse(localStorage['mage-cache-storage']);\n        if(customerData && typeof customerData.customer !== 'undefined' && customerData.customer.email != null){\n            var  customerEmail = customerData.customer.email;\n            document.getElementById(\"newsletter_modal_email\").value = customerEmail;\n        }\n    }\n</script>\n\n\n<div class=\"page-wrapper\"><div class=\"header__main-container\">\n    <div class=\"header__container js-header__container\">\n        <header class=\"header js-header header--modal\">\n            <div class=\"container container--header\">\n                <div class=\"header__wrapper\">\n                    \n                    <div class=\"header__buttons header__buttons__left\">\n                        \n                <div class=\"currency-lang__chooser currency-lang-slide__chooser fill-data\">\n                    <a href=\"javascript:void(0);\" class=\"currency-lang__icon js-currency-lang__icon js-country-lang-slide__opener\" role=\"button\" aria-label=\"Select Country\">\n                                                <img loading=\"lazy\" class=\"js-selected-img-value\" src=\"https://www.zimmermann.com/static/version1780978756/frontend/tryzens/zimmermann/en_US/images/countries/us.svg\" alt=\"\">\n                    </a>\n                                        <span class=\"currency-lang__separator currency-lang-slide__separator js-lang-available currency-lang__language-hide\">|</span>\n                    <div class=\"currency-lang__country--wrap\">\n                        <a data-fallback-lang=\"\" href=\"javascript:void(0);\" class=\"currency-lang__country currency-lang-slide__country js-currency-lang__country js-country-lang-slide__opener js-lang-available currency-lang__language-hide\" role=\"button\">\n                            <div class=\"sr-only\">Select language. Currently selected </div>\n                            English</a>\n                    </div",
